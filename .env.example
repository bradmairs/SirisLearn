# SirisLearn. Copy to .env and fill in.

# Host port and bind address. SirisOS uses 8094, SirisDrone 8096, SirisHome 8098.
SIRISLEARN_PORT=8100
SIRISLEARN_BIND=0.0.0.0
# Days, streaks and the daily goal follow this time zone.
SIRISLEARN_TIMEZONE=Australia/Melbourne

# Sign-in (one user).
SIRISLEARN_ADMIN_USERNAME=brad
SIRISLEARN_ADMIN_PASSWORD=change-this-password
# A long random value: openssl rand -hex 32
SIRISLEARN_JWT_SECRET=replace-with-a-long-random-secret
SIRISLEARN_JWT_EXPIRY_HOURS=720

# --- The course writer --------------------------------------------------------
# anthropic | ollama | none. Blank picks Claude when ANTHROPIC_API_KEY is set,
# else Ollama when OLLAMA_URL and SIRISLEARN_OLLAMA_MODEL are set.
SIRISLEARN_LLM_PROVIDER=
# Claude (recommended): https://console.anthropic.com
ANTHROPIC_API_KEY=
SIRISLEARN_MODEL=claude-opus-5-5
# How hard Claude thinks when writing a lesson: low | medium | high.
SIRISLEARN_EFFORT=medium
# Or a model on your LAN Ollama (it must support JSON-schema output).
OLLAMA_URL=
SIRISLEARN_OLLAMA_MODEL=
# next = write each lesson when it's opened, plus the one after it (cheapest).
# all  = write the whole course in the background as soon as it's planned.
SIRISLEARN_PREGENERATE=next

# Starting daily goal in XP (changeable in Settings).
SIRISLEARN_DAILY_GOAL=50
# Add the "How to learn anything faster" starter course on first run.
SIRISLEARN_SEED_SAMPLE=true

# --- SirisOS ------------------------------------------------------------------
# The key SirisOS sends to read the widget, search and status routes. Set the
# same value as SIRISLEARN_HUB_KEY in SirisOS's .env. openssl rand -hex 32
SIRISLEARN_HUB_KEY=
